desc             = ProRes 4444 with alpha, MOV (graphics, keys, lower thirds)
category         = post
ext              = mov
scan             = keep
pix_fmt          = yuva444p10le
video            = -c:v prores_ks -profile:v 4 -vendor apl0 -alpha_bits 16
video_interlaced = -flags +ildct
audio_map        = all
audio            = -c:a pcm_s24le
format           = -f mov
expect           = codec_name=prores,profile=4444,pix_fmt=yuva444p12le
